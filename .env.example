# Copy to .env and adjust as needed.
GR4_ENV_NAME=local

# Workspace layout, relative to the workspace repository root.
GR4_SRC_DIR=src
GR4_BUILD_DIR=build
GR4_PREFIX_DIR=install

# Toolchain / build tools.
# GR4_LLVM_ROOT=/opt/homebrew/opt/llvm
# GR4_CC=clang
# GR4_CXX=clang++
GR4_PKGCONF=pkgconf
GR4_BUILD_JOBS=6
GR4_BUILD_PROFILE=dev

# Optional runtime knobs.
GR4_LOG_LEVEL=info
GR4_DEBUG=0
